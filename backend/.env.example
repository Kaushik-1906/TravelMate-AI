# TravelMate AI - Backend Environment Configuration
# SERVER-ONLY SECRETS: never commit the real .env file or expose these values to the frontend.

# App environment & CORS
# APP_ENV=production disables demo auth and demo accounts.
APP_ENV=development
# Comma-separated list of allowed frontend origins.
FRONTEND_ORIGIN=http://localhost:5173

# Supabase Database & Auth (optional)
# Leave blank to run the backend in local demo mode (in-memory persistence + demo auth).
# Demo mode is only permitted when APP_ENV is not "production".
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: only needed for trusted server-side admin tasks. Not required for normal app usage.
SUPABASE_SERVICE_ROLE_KEY=

# AI Generation Engine
# Providers supported: "demo", "gemini", "openai", "groq"
# If AI_API_KEY is not set or AI_PROVIDER is "demo", the built-in demo generator is used.
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
# Optional OpenAI-compatible base URL (required for custom gateways; Groq is auto-detected).
AI_BASE_URL=
# Timeout for a single AI provider call, in seconds.
AI_TIMEOUT_SECONDS=60
# Maximum provider calls per itinerary request (initial attempt + repair retries), capped at 3.
AI_MAX_ATTEMPTS=2
# If true, a failed live AI call returns a clearly labelled demo itinerary instead of an error.
# Keep false in production so failures are never presented as live AI output.
AI_DEMO_FALLBACK=false

# Per-IP rate limiting for expensive endpoints (AI generation / regeneration).
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_WINDOW_SECONDS=600
